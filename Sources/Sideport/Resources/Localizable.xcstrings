    },
    "The binary is encrypted with FairPlay: it only runs on devices signed in with the Apple ID that downloaded it. Re-signing would change the signature but not the encryption.": {
      "comment": "Why an App Store copy cannot be re-signed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The binary is encrypted with FairPlay: it only runs on devices signed in with the Apple ID that downloaded it. Re-signing would change the signature but not the encryption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il binario è cifrato con FairPlay: funziona solo sui dispositivi con l'Apple ID che l'ha scaricata. Rifirmarla cambierebbe la firma ma non la cifratura."
          }
        }
      }
