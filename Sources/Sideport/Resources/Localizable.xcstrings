    "Add an Apple Development or Apple Distribution certificate to the keychain, for example from Xcode under Settings › Accounts.": {
      "comment": "How to get a signing identity.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an Apple Development or Apple Distribution certificate to the keychain, for example from Xcode under Settings › Accounts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi al portachiavi un certificato Apple Development o Apple Distribution, per esempio da Xcode in Impostazioni › Account."
          }
        }
      }
    },
    "Add the .ipa files you want to install on your devices. You can also drag them here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the .ipa files you want to install on your devices. You can also drag them here."
