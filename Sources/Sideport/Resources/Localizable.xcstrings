{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@)": {
      "comment": "Marketing name followed by the internal model identifier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        }
      }
    },
    "%@ failed: %@": {
      "comment": "Re-signing error: an external command failed; first the tool name, then its output.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed: %@"
          }
        },
