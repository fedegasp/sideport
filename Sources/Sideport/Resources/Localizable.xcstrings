    "Cannot reach the device over Wi-Fi: check that it is awake and on the same network, and that Sideport is allowed under System Settings > Privacy & Security > Local Network.": {
      "comment": "Shown when lockdownd cannot be reached on a network device (mux error).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the device over Wi-Fi: check that it is awake and on the same network, and that Sideport is allowed under System Settings > Privacy & Security > Local Network."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo non raggiungibile in Wi-Fi: controlla che sia sveglio e sulla stessa rete, e che Sideport sia abilitata in Impostazioni di Sistema > Privacy e sicurezza > Rete locale."
          }
        }
      }
